node_modules/
dist/
*.tsbuildinfo

# Dados locais (nunca commitar) — banco/ inteiro: .db, .bak-*, .trava*,
# scratch de teste. O auto-update exige árvore limpa; sem isto, resíduos
# locais de runtime bloqueiam o fast-forward com "árvore suja".
/banco/
arquivos/campanhas/*
!arquivos/campanhas/.gitkeep
backups/*
!backups/.gitkeep

# Segredos e ambiente local
.env
.env.*
!.env.example
configuracao/local.json
configuracao/auto-update.json

# Logs
*.log
npm-debug.log*

logs/

# Sandboxes de teste locais
teste-sandbox-*/

# simulacao de limpeza v1.0 (copias de banco de teste)
simulacao-limpeza/

# screenshots/dados do teste visual de ficha
visual-ficha-limpeza/

# evidências da homologação visual (screenshots gerados por homologacao-visual.mjs)
_evidencias/
