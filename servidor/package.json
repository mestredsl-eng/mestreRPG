{
  "name": "@mestre-rpg/servidor",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test:iniciativa": "tsx --test testes/iniciativa.test.ts",
    "test:regua": "tsx --test testes/regua.test.ts",
    "test:d10": "tsx --test testes/d10.test.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test:guildas-guarda": "tsx --test testes/guildas-guarda.test.ts",
    "test:backup-contrato": "tsx --test testes/backup-contrato.test.ts",
    "test:comercio": "tsx --test testes/comercio-schema.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.9.0",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
